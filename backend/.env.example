# Option B: Shared secret fallback (when Firebase Admin is not configured)
# Must match VITE_APP_SOCKET_SECRET in frontend Vercel env vars
APP_SOCKET_SECRET=hiefdcjswodcwcd gwhcd w jdw d

# ── AI PROXY ────────────────────────────────────────────────────
